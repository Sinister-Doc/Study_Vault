flowchart TD
    A["Board of Revenue<br/>(Revenue & Land Reforms)"] --> B["Divisional Commissioner<br/>(5 divisions)"]
    B --> C["Deputy Commissioner<br/>(District / 31+)"]
    C --> D["Assistant Commissioner<br/>(sub-division)"]
    D --> E["Taluk Tahsildar<br/>+ Naib Mamlatdar"]
    E --> F["Revenue Inspector /<br/>Municipal officer"]
    F --> G["Village Accountant<br/>(ಗ್ರಾಮ ಲೆಕ್ಕಾಪಿಶಿ / V.A.)"]
    C --> H["Sub-Divisional Officer<br/>of Survey (S.D.O. Survey)"]
    H --> I["Assistant Engineer /<br/>Surveyor, Draftsman"]
    I --> G
    A --> J["Directorate of Settlement<br/>& Surveys (DSS)"]
    J --> H
    G --> K["Patwari work: Pahani,<br/>mutation, crops"]
